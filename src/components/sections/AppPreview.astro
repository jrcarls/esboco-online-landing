---
import { Image } from 'astro:assets';
import logoLight from '../../assets/logo-light.svg';
import logoIcon from '../../assets/logo-icon.svg';
---

<section id="preview" class="preview-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Explore o app antes de criar sua conta</h2>
      <p class="section-sub">Navegue pelas funcionalidades como se estivesse logado. Sem precisar se cadastrar.</p>
    </div>

    <div class="browser-frame" role="presentation" aria-label="Prévia do aplicativo">
      <!-- Browser chrome -->
      <div class="browser-topbar">
        <div class="browser-dots">
          <span class="dot" style="background:#ff5f57"></span>
          <span class="dot" style="background:#ffbd2e"></span>
          <span class="dot" style="background:#28c840"></span>
        </div>
        <div class="browser-urlbar">
          <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          app.esbocoonline.com.br
        </div>
        <div style="width:52px"></div>
      </div>

      <!-- App window -->
      <div class="app-window">

        <!-- Sidebar desktop -->
        <aside class="app-sidebar">
          <div class="sidebar-logo-wrap">
            <Image src={logoLight} alt="Esboço Online" class="sidebar-logo" />
          </div>

          <nav class="sidebar-nav">
            <button class="nav-item" data-tab="inicio">
              <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <span>Início</span>
            </button>
            <button class="nav-item active" data-tab="esbocos">
              <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              <span>Meus Esboços</span>
            </button>
            <button class="nav-item" data-tab="biblia">
              <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              <span>Bíblia</span>
            </button>
            <button class="nav-item" data-tab="agenda">
              <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>Agenda</span>
            </button>
            <button class="nav-item" data-tab="favoritos">
              <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
              <span>Favoritos</span>
            </button>
          </nav>

          <div class="sidebar-bottom">
            <button class="sidebar-btn">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <span>Feedback</span>
            </button>
            <button class="sidebar-btn">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span>Ajuda & Suporte</span>
            </button>
          </div>

          <div class="sidebar-footer">
            <div class="user-chip">
              <div class="user-avatar">P</div>
              <span class="user-name">Pastor João</span>
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-left:auto;color:#9ca3af;flex-shrink:0"><polyline points="18 15 12 9 6 15"/></svg>
            </div>
          </div>
        </aside>

        <!-- Main content -->
        <main class="app-main">

          <!-- ── Panel: Início ── -->
          <div class="panel" id="tab-inicio">
            <div class="panel-header">
              <div>
                <h1 class="panel-title">Boa tarde, Pastor João!</h1>
                <p class="panel-sub">sábado, 31 de maio de 2026</p>
              </div>
              <button class="btn-primary-sm">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Novo esboço
              </button>
            </div>

            <div class="card verse-day-card">
              <p class="card-label">Versículo do dia</p>
              <blockquote class="verse-day-text">"Porque Deus amou o mundo de tal maneira que deu o seu Filho unigênito, para que todo aquele que nele crê não pereça, mas tenha a vida eterna."</blockquote>
              <p class="verse-day-ref">— João 3:16</p>
            </div>

            <div class="group-block">
              <p class="group-label">Próximo evento</p>
              <div class="card row-card">
                <div class="event-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="color:#7c3aed"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="row-info">
                  <p class="row-title">Culto de Domingo</p>
                  <p class="row-meta">Dom, 1 jun · 10:00 · Igreja Central</p>
                </div>
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:#d1d5db;flex-shrink:0"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
            </div>

            <div class="group-block">
              <div class="group-row-header">
                <p class="group-label" style="margin-bottom:0">Esboços recentes</p>
                <span class="link-sm">Ver todos</span>
              </div>
              <div class="card-stack">
                <div class="card row-card">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="color:#9ca3af;flex-shrink:0"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                  <span class="row-title flex-1">A Fé que Move Montanhas</span>
                  <span class="row-date">2 dias atrás</span>
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:#d1d5db;flex-shrink:0"><polyline points="9 18 15 12 9 6"/></svg>
                </div>
                <div class="card row-card">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="color:#9ca3af;flex-shrink:0"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                  <span class="row-title flex-1">O Amor de Deus — João 3:16</span>
                  <span class="row-date">5 dias atrás</span>
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:#d1d5db;flex-shrink:0"><polyline points="9 18 15 12 9 6"/></svg>
                </div>
                <div class="card row-card">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="color:#9ca3af;flex-shrink:0"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                  <span class="row-title flex-1">Crescendo na Graça</span>
                  <span class="row-date">1 semana atrás</span>
                  <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:#d1d5db;flex-shrink:0"><polyline points="9 18 15 12 9 6"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- ── Panel: Meus Esboços ── -->
          <div class="panel active" id="tab-esbocos">
            <div class="panel-header">
              <div>
                <h1 class="panel-title">Meus Esboços</h1>
                <p class="panel-sub">6 esboços <span style="color:#9ca3af">(6/10)</span></p>
              </div>
              <button class="btn-primary-sm">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Novo Esboço
              </button>
            </div>

            <div class="search-input">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:#9ca3af;flex-shrink:0"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <span style="color:#9ca3af;font-size:.8125rem">Buscar...</span>
            </div>

            <div class="esbocos-grid">
              <div class="card esboco-card">
                <div class="esboco-top">
                  <h3 class="esboco-titulo">A Fé que Move Montanhas</h3>
                  <button class="dots-btn" aria-label="Mais opções">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                  </button>
                </div>
                <p class="esboco-resumo">Baseado em Mateus 17:20. Uma pregação sobre a importância da fé genuína e como ela transforma nossa vida.</p>
                <span class="esboco-data">2 dias atrás</span>
              </div>
              <div class="card esboco-card">
                <div class="esboco-top">
                  <h3 class="esboco-titulo">O Amor de Deus</h3>
                  <button class="dots-btn" aria-label="Mais opções">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                  </button>
                </div>
                <p class="esboco-resumo">Uma reflexão profunda sobre o amor incondicional de Deus e o sacrifício de Jesus Cristo pela humanidade.</p>
                <span class="esboco-data">5 dias atrás</span>
              </div>
              <div class="card esboco-card">
                <div class="esboco-top">
                  <h3 class="esboco-titulo">Crescendo na Graça</h3>
                  <button class="dots-btn" aria-label="Mais opções">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                  </button>
                </div>
                <p class="esboco-resumo">Como crescer espiritualmente por meio da Palavra, oração e comunhão com outros irmãos em Cristo.</p>
                <span class="esboco-data">1 semana atrás</span>
              </div>
              <div class="card esboco-card">
                <div class="esboco-top">
                  <h3 class="esboco-titulo">A Oração de Jabez</h3>
                  <button class="dots-btn" aria-label="Mais opções">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                  </button>
                </div>
                <p class="esboco-resumo">Estudo aprofundado sobre 1 Crônicas 4:10 e como essa oração pode ser aplicada em nossas vidas hoje.</p>
                <span class="esboco-data">2 semanas atrás</span>
              </div>
              <div class="card esboco-card">
                <div class="esboco-top">
                  <h3 class="esboco-titulo">O Servo Fiel</h3>
                  <button class="dots-btn" aria-label="Mais opções">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                  </button>
                </div>
                <p class="esboco-resumo">Reflexão sobre a parábola dos talentos e o que significa ser um servo fiel no Reino de Deus.</p>
                <span class="esboco-data">3 semanas atrás</span>
              </div>
              <div class="card esboco-card">
                <div class="esboco-top">
                  <h3 class="esboco-titulo">Nova Criação em Cristo</h3>
                  <button class="dots-btn" aria-label="Mais opções">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                  </button>
                </div>
                <p class="esboco-resumo">Com base em 2 Coríntios 5:17, explorando a transformação que acontece quando nos tornamos nova criação.</p>
                <span class="esboco-data">1 mês atrás</span>
              </div>
            </div>
          </div>

          <!-- ── Panel: Bíblia ── -->
          <div class="panel" id="tab-biblia">
            <div class="panel-header">
              <h1 class="panel-title">Bíblia</h1>
            </div>

            <div class="search-input" style="margin-bottom:.625rem">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:#9ca3af;flex-shrink:0"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <span style="color:#9ca3af;font-size:.8125rem">Busque por referência: João 3, Salmos 23...</span>
            </div>

            <div class="biblia-controls">
              <div class="fake-select flex-1">
                <span>João</span>
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
              <div class="fake-select" style="width:72px">
                <span>3</span>
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
            </div>

            <div class="biblia-nav">
              <button class="btn-ghost-xs">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Anterior
              </button>
              <span class="biblia-ref">João 3</span>
              <button class="btn-ghost-xs">
                Próximo
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>

            <div class="card verses-wrap">
              <div class="verse-row hl-yellow">
                <sup class="vnum">1</sup>
                <span>Havia um homem dos fariseus, chamado Nicodemos, um dos principais dos judeus.</span>
                <button class="bk-btn" aria-label="Salvar versículo">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                </button>
              </div>
              <div class="verse-row">
                <sup class="vnum">2</sup>
                <span>Este foi ter com Jesus de noite, e disse-lhe: Rabi, sabemos que és Mestre vindo da parte de Deus; porque ninguém pode fazer estes sinais que tu fazes, se Deus não for com ele.</span>
                <button class="bk-btn" aria-label="Salvar versículo">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                </button>
              </div>
              <div class="verse-row">
                <sup class="vnum">3</sup>
                <span>Jesus respondeu, e disse-lhe: Na verdade, na verdade te digo que aquele que não nascer de novo não pode ver o reino de Deus.</span>
                <button class="bk-btn bk-saved" aria-label="Salvo nos favoritos">
                  <svg width="14" height="14" fill="currentColor" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                </button>
              </div>
              <div class="verse-row hl-blue">
                <sup class="vnum">4</sup>
                <span>Disse-lhe Nicodemos: Como pode um homem nascer sendo velho? Pode tornar a entrar no ventre de sua mãe e nascer?</span>
                <button class="bk-btn" aria-label="Salvar versículo">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                </button>
              </div>
              <div class="verse-row">
                <sup class="vnum">5</sup>
                <span>Jesus respondeu: Na verdade, na verdade te digo que aquele que não nascer da água e do Espírito não pode entrar no reino de Deus.</span>
                <button class="bk-btn" aria-label="Salvar versículo">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                </button>
              </div>
              <div class="verse-row hl-yellow">
                <sup class="vnum">16</sup>
                <span>Porque Deus amou o mundo de tal maneira que deu o seu Filho unigênito, para que todo aquele que nele crê não pereça, mas tenha a vida eterna.</span>
                <button class="bk-btn bk-saved" aria-label="Salvo nos favoritos">
                  <svg width="14" height="14" fill="currentColor" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ── Panel: Agenda ── -->
          <div class="panel" id="tab-agenda">
            <div class="panel-header">
              <h1 class="panel-title">Agenda</h1>
              <button class="btn-primary-sm">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Novo evento
              </button>
            </div>

            <div class="card mini-cal">
              <div class="cal-head">
                <button class="cal-nav-btn">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <span class="cal-month">Junho 2026</span>
                <button class="cal-nav-btn">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
              </div>
              <div class="cal-grid">
                <span class="wday">D</span><span class="wday">S</span><span class="wday">T</span><span class="wday">Q</span><span class="wday">Q</span><span class="wday">S</span><span class="wday">S</span>
                <span class="cday empty"></span>
                <span class="cday ev">1</span>
                <span class="cday ev">2</span>
                <span class="cday">3</span>
                <span class="cday ev">4</span>
                <span class="cday">5</span>
                <span class="cday ev">6</span>
                <span class="cday ev">7</span>
                <span class="cday">8</span>
                <span class="cday ev">9</span>
                <span class="cday">10</span>
                <span class="cday">11</span>
                <span class="cday">12</span>
                <span class="cday">13</span>
                <span class="cday ev">14</span>
                <span class="cday">15</span>
                <span class="cday">16</span>
                <span class="cday ev">17</span>
                <span class="cday">18</span>
                <span class="cday">19</span>
                <span class="cday ev">20</span>
                <span class="cday ev">21</span>
                <span class="cday">22</span>
                <span class="cday ev">23</span>
                <span class="cday">24</span>
                <span class="cday ev">25</span>
                <span class="cday">26</span>
                <span class="cday">27</span>
                <span class="cday ev">28</span>
                <span class="cday">29</span>
                <span class="cday ev">30</span>
              </div>
            </div>

            <p class="group-label">Próximos eventos</p>
            <div class="card-stack">
              <div class="card row-card">
                <div class="date-badge"><span class="db-day">1</span><span class="db-mon">JUN</span></div>
                <div class="row-info">
                  <p class="row-title">Culto de Domingo</p>
                  <p class="row-meta">10:00 · Igreja Central</p>
                </div>
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:#d1d5db;flex-shrink:0"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
              <div class="card row-card">
                <div class="date-badge"><span class="db-day">2</span><span class="db-mon">JUN</span></div>
                <div class="row-info">
                  <p class="row-title">Reunião de Pastores</p>
                  <p class="row-meta">19:00 · Escritório</p>
                </div>
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:#d1d5db;flex-shrink:0"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
              <div class="card row-card">

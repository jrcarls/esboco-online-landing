---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  color?: 'primary' | 'secondary' | 'accent';
  animated?: boolean;
  position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'center';
  delay?: number;
  class?: string;
}

const {
  size = 'md',
  color = 'primary',
  animated = true,
  position,
  delay = 0,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'blob',
    `blob--${size}`,
    `blob--${color}`,
    { 'blob--animated': animated },
    position ? `blob--pos blob--pos-${position}` : '',
    className,
  ]}
  style={delay ? `animation-delay: -${delay}s` : undefined}
  aria-hidden="true"
></div>

<style>
  .blob {
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    pointer-events: none;
    flex-shrink: 0;
    will-change: border-radius;
  }

  .blob--sm { width: 160px;  height: 140px; }
  .blob--md { width: 340px;  height: 300px; }
  .blob--lg { width: 560px;  height: 500px; }

  .blob--primary {
    background: radial-gradient(ellipse at 38% 38%, #a78bfa 0%, #7c3aed 50%, #5b21b6 100%);
    opacity: 0.5;
  }
  .blob--secondary {
    background: radial-gradient(ellipse at 38% 38%, #a5b4fc 0%, #6366f1 50%, #4338ca 100%);
    opacity: 0.45;
  }
  .blob--accent {
    background: radial-gradient(ellipse at 38% 38%, #e9d5ff 0%, #c4b5fd 50%, #8b5cf6 100%);
    opacity: 0.4;
  }

  .blob--pos {
    position: absolute;
    z-index: 0;
  }
  .blob--pos-top-left     { top: -10%;    left: -8%;  }
  .blob--pos-top-right    { top: -10%;    right: -8%; }
  .blob--pos-bottom-left  { bottom: -10%; left: -8%;  }
  .blob--pos-bottom-right { bottom: -10%; right: -8%; }
  .blob--pos-center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .blob--animated {
    animation: blob-morph 14s ease-in-out infinite;
  }

  @keyframes blob-morph {
    0%,  100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
    20%        { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
    40%        { border-radius: 50% 50% 20% 80% / 25% 80% 20% 75%; }
    60%        { border-radius: 40% 60% 60% 40% / 60% 40% 40% 60%; }
    80%        { border-radius: 70% 30% 40% 60% / 40% 65% 35% 60%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob--animated { animation: none; }
  }
</style>

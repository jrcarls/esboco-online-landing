---
interface Props {
  highlighted?: boolean;
  class?: string;
}

const { highlighted = false, class: className } = Astro.props;
---

<div class:list={['card', { 'card--highlighted': highlighted }, className]}>
  <slot />
</div>

<style>
  .card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(124, 58, 237, .1);
    border-color: rgba(124, 58, 237, .2);
  }

  .card--highlighted {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary), var(--shadow-lg);
  }
</style>

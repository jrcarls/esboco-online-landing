---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/sections/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';

const allPosts = await getCollection('blog');

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = posts.find((p) => p.data.featured);
const rest     = posts.filter((p) => !p.data.featured);

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
}

function readTime(body: string) {
  return Math.max(1, Math.ceil(body.split(/\s+/).length / 200));
}
---

<Layout
  title="Blog - Esboço Online"
  description="Reflexões, dicas e recursos para pastores, pregadores e líderes ministeriais."
>
  <Navbar />

  <main>
    <!-- Hero -->
    <section class="blog-hero">
      <div class="container blog-hero__inner">
        <span class="blog-tag">Blog</span>
        <h1 class="blog-hero__title">Reflexões para o<br />ministério</h1>
        <p class="blog-hero__sub">
          Recursos práticos, dicas de pregação e estudo bíblico para pastores
          e líderes que levam o ministério a sério.
        </p>
      </div>
    </section>

    <!-- Posts -->
    <section class="blog-posts">
      <div class="container">

        <!-- Featured -->
        {featured && (
          <a href={`/blog/${featured.id}`} class="blog-featured">
            <div class="blog-featured__stripe blog-featured__stripe--pregacao"></div>
            <div class="blog-featured__body">
              <div class="blog-featured__meta">
                <span class="blog-category">{featured.data.category}</span>
                <span class="blog-dot" aria-hidden="true">·</span>
                <span class="blog-date">{formatDate(featured.data.pubDate)}</span>
                <span class="blog-dot" aria-hidden="true">·</span>
                <span class="blog-read">{readTime(featured.body)} min de leitura</span>
              </div>
              <h2 class="blog-featured__title">{featured.data.title}</h2>
              <p class="blog-featured__desc">{featured.data.description}</p>
              <span class="blog-featured__cta">Ler artigo →</span>
            </div>
          </a>
        )}

        <!-- Grid -->
        {rest.length > 0 && (
          <div class="blog-grid">
            {rest.map((post) => (
              <a href={`/blog/${post.id}`} class="blog-card">
                <div class:list={['blog-card__stripe', `blog-card__stripe--${post.data.category.toLowerCase().replace(/\s+/g, '-')}`]}></div>
                <div class="blog-card__body">
                  <div class="blog-card__meta">
                    <span class="blog-category">{post.data.category}</span>
                    <span class="blog-dot" aria-hidden="true">·</span>
                    <span class="blog-read">{readTime(post.body)} min</span>
                  </div>
                  <h3 class="blog-card__title">{post.data.title}</h3>
                  <p class="blog-card__desc">{post.data.description}</p>
                  <span class="blog-card__date">{formatDate(post.data.pubDate)}</span>
                </div>
              </a>
            ))}
          </div>
        )}

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Hero ──────────────────────────────────────── */
  .blog-hero {
    padding: 6rem 0 4.5rem;
    background: linear-gradient(180deg, #fdfcff 0%, #f5f3ff 100%);
    border-bottom: 1px solid rgba(124, 58, 237, .1);
  }

  .blog-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .blog-tag {
    display: inline-block;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    border: 1px solid rgba(124, 58, 237, .2);
    border-radius: var(--radius-full);
    padding: .3rem .9rem;
  }

  .blog-hero__title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -.035em;
    line-height: 1.1;
    color: var(--color-text);
  }

  .blog-hero__sub {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    max-width: 520px;
    line-height: 1.75;
  }

  /* ── Posts section ─────────────────────────────── */
  .blog-posts {
    padding: 4rem 0 6rem;
    background: #fff;
  }

  /* ── Featured ──────────────────────────────────── */
  .blog-featured {
    display: grid;
    grid-template-columns: 6px 1fr;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    margin-bottom: 2.5rem;
    transition: box-shadow .22s ease, transform .22s ease;
    text-decoration: none;
    color: inherit;
    background: #fff;
  }
  .blog-featured:hover {
    box-shadow: 0 16px 48px rgba(124, 58, 237, .12);
    transform: translateY(-2px);
  }

  .blog-featured__stripe {
    width: 6px;
    background: linear-gradient(180deg, var(--color-primary) 0%, #6366f1 100%);
    flex-shrink: 0;
  }

  .blog-featured__body {
    padding: 2.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .blog-featured__meta {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
  }

  .blog-featured__title {
    font-size: clamp(1.5rem, 2.5vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -.025em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .blog-featured__desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 680px;
  }

  .blog-featured__cta {
    display: inline-block;
    font-size: .9375rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: .25rem;
  }

  /* ── Grid ──────────────────────────────────────── */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  /* ── Card ──────────────────────────────────────── */
  .blog-card {
    display: grid;
    grid-template-columns: 4px 1fr;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: box-shadow .22s ease, transform .22s ease;
    text-decoration: none;
    color: inherit;
    background: #fff;
  }
  .blog-card:hover {
    box-shadow: 0 10px 32px rgba(124, 58, 237, .1);
    transform: translateY(-2px);
  }

  .blog-card__stripe {
    width: 4px;
    background: linear-gradient(180deg, var(--color-primary) 0%, #6366f1 100%);
  }
  .blog-card__stripe--estudo-bíblico,
  .blog-card__stripe--estudo-b-blico {
    background: linear-gradient(180deg, #6366f1 0%, #4338ca 100%);
  }
  .blog-card__stripe--gestão,
  .blog-card__stripe--gest-o {
    background: linear-gradient(180deg, #8b5cf6 0%, #7c3aed 100%);
  }

  .blog-card__body {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: .4rem;
  }

  .blog-card__title {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -.015em;
    line-height: 1.35;
    color: var(--color-text);
  }

  .blog-card__desc {
    font-size: .9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    flex: 1;
  }

  .blog-card__date {
    font-size: .8125rem;
    color: var(--color-text-subtle);
    margin-top: .25rem;
  }

  /* ── Shared meta atoms ─────────────────────────── */
  .blog-category {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    border-radius: var(--radius-full);
    padding: .2rem .6rem;
  }

  .blog-dot {
    color: var(--color-border);
    font-size: .875rem;
  }

  .blog-date,
  .blog-read {
    font-size: .8125rem;
    color: var(--color-text-subtle);
  }

  /* ── Responsive ────────────────────────────────── */
  @media (max-width: 700px) {
    .blog-grid { grid-template-columns: 1fr; }
    .blog-featured__body { padding: 1.5rem; }
    .blog-hero { padding: 4.5rem 0 3rem; }
  }
</style>

---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/sections/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import { REGISTER_URL } from '../../data/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
}

const readTime = Math.max(1, Math.ceil((post.body ?? '').split(/\s+/).length / 200));

const siteURL = 'https://esbocoonline.com.br';
const postURL = `${siteURL}/blog/${post.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Esboço Online', url: siteURL },
  url: postURL,
  articleSection: post.data.category,
};
---

<Layout
  title={`${post.data.title} - Esboço Online`}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  author={post.data.author}
  section={post.data.category}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Navbar />

  <main>
    <!-- Header do post -->
    <header class="post-header">
      <div class="container post-header__inner">
        <a href="/blog" class="post-back">← Blog</a>

        <div class="post-meta">
          <span class="post-category">{post.data.category}</span>
          <span class="post-dot" aria-hidden="true">·</span>
          <span class="post-info">{formatDate(post.data.pubDate)}</span>
          <span class="post-dot" aria-hidden="true">·</span>
          <span class="post-info">{readTime} min de leitura</span>
        </div>

        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>

        <div class="post-author">
          <div class="post-author__avatar" aria-hidden="true">
            {post.data.author.charAt(0)}
          </div>
          <span class="post-author__name">{post.data.author}</span>
        </div>
      </div>
    </header>

    <!-- Conteúdo -->
    <article class="post-body">
      <div class="container">
        <div class="prose">
          <Content />
        </div>
      </div>
    </article>

    <!-- CTA -->
    <section class="post-cta">
      <div class="container post-cta__inner">
        <p class="post-cta__text">Organize seus sermões com o Esboço Online</p>
        <a href={REGISTER_URL} class="post-cta__btn">Criar minha conta →</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Header ────────────────────────────────────── */
  .post-header {
    padding: 4rem 0 3.5rem;
    background: linear-gradient(180deg, #fdfcff 0%, #f5f3ff 100%);
    border-bottom: 1px solid rgba(124, 58, 237, .1);
  }

  .post-header__inner {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-back {
    font-size: .875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color .15s;
    align-self: flex-start;
  }
  .post-back:hover { color: var(--color-primary); }

  .post-meta {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
  }

  .post-category {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    border: 1px solid rgba(124, 58, 237, .15);
    border-radius: var(--radius-full);
    padding: .2rem .65rem;
  }

  .post-dot  { color: var(--color-border); }
  .post-info { font-size: .875rem; color: var(--color-text-subtle); }

  .post-title {
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -.035em;
    line-height: 1.15;
    color: var(--color-text);
  }

  .post-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding-top: .25rem;
  }

  .post-author__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary) 0%, #6366f1 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .875rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }

  .post-author__name {
    font-size: .9375rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  /* ── Body ──────────────────────────────────────── */
  .post-body {
    padding: 4rem 0;
    background: #fff;
  }

  .post-body .container { max-width: 720px; }

  /* ── Prose ─────────────────────────────────────── */
  .prose { line-height: 1.8; color: var(--color-text); font-size: 1.0625rem; }

  .prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--color-text);
    margin: 2.5rem 0 1rem;
    line-height: 1.3;
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -.015em;
    color: var(--color-text);
    margin: 2rem 0 .75rem;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .prose :global(li) {
    padding-left: .25rem;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding: .75rem 1.25rem;
    margin: 2rem 0;
    background: var(--color-primary-bg);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }

  .prose :global(code) {
    font-family: 'Courier New', monospace;
    font-size: .875em;
    background: var(--color-bg-muted);
    border-radius: 4px;
    padding: .15em .4em;
    color: var(--color-primary-dark);
  }

  /* ── Post CTA ──────────────────────────────────── */
  .post-cta {
    padding: 3rem 0 4rem;
    background: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border);
  }

  .post-cta__inner {
    max-width: 720px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .post-cta__text {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .post-cta__btn {
    display: inline-flex;
    align-items: center;
    font-size: .9375rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(135deg, var(--color-primary) 0%, #6366f1 100%);
    border-radius: var(--radius-full);
    padding: .7rem 1.6rem;
    box-shadow: 0 4px 14px rgba(124, 58, 237, .35);
    transition: box-shadow .2s ease, transform .2s ease;
    white-space: nowrap;
  }
  .post-cta__btn:hover {
    box-shadow: 0 8px 24px rgba(124, 58, 237, .45);
    transform: translateY(-1px);
  }

  /* ── Responsive ────────────────────────────────── */
  @media (max-width: 600px) {
    .post-header { padding: 3rem 0 2.5rem; }
    .post-cta__inner { flex-direction: column; align-items: flex-start; }
  }
</style>

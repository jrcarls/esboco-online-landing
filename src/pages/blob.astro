---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import Blob from '../components/ui/Blob.astro';
---

<Layout
  title="Blob Component — Esboço Online"
  description="Showcase do componente Blob: formas orgânicas animadas para fundos e decorações de seção."
>
  <Navbar />

  <main>

    <!-- ─── Hero ─────────────────────────────────────── -->
    <section class="bd-hero">
      <Blob size="lg" color="primary" animated position="top-right" />
      <Blob size="md" color="secondary" animated position="bottom-left" delay={5} />

      <div class="container bd-hero__inner">
        <span class="bd-tag">UI Component</span>
        <h1 class="bd-hero__title">Blob</h1>
        <p class="bd-hero__sub">
          Formas orgânicas animadas para enriquecer fundos e seções com
          movimento suave e atmosférico.
        </p>

        <div class="bd-hero__meta">
          <span class="bd-pill">size: sm · md · lg</span>
          <span class="bd-pill">color: primary · secondary · accent</span>
          <span class="bd-pill">animated: boolean</span>
          <span class="bd-pill">position: 5 variações</span>
        </div>
      </div>
    </section>

    <!-- ─── Tamanhos ──────────────────────────────────── -->
    <section class="bd-section bd-section--light">
      <div class="container">
        <header class="bd-section__header">
          <span class="bd-label">prop</span>
          <h2 class="bd-section__title">size</h2>
          <p class="bd-section__sub">Três escalas para se adaptar a qualquer contexto de layout.</p>
        </header>

        <div class="bd-grid bd-grid--3">
          <div class="bd-card">
            <div class="bd-card__stage bd-card__stage--sm">
              <Blob size="sm" color="primary" animated position="center" />
            </div>
            <div class="bd-card__info">
              <code class="bd-code">size="sm"</code>
              <span class="bd-dim">160 × 140 px</span>
            </div>
          </div>

          <div class="bd-card">
            <div class="bd-card__stage bd-card__stage--md">
              <Blob size="md" color="primary" animated position="center" />
            </div>
            <div class="bd-card__info">
              <code class="bd-code">size="md"</code>
              <span class="bd-dim">340 × 300 px</span>
            </div>
          </div>

          <div class="bd-card">
            <div class="bd-card__stage bd-card__stage--lg">
              <Blob size="lg" color="primary" animated position="center" />
            </div>
            <div class="bd-card__info">
              <code class="bd-code">size="lg"</code>
              <span class="bd-dim">560 × 500 px</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Cores ─────────────────────────────────────── -->
    <section class="bd-section bd-section--dark">
      <div class="container">
        <header class="bd-section__header bd-section__header--light">
          <span class="bd-label bd-label--dim">prop</span>
          <h2 class="bd-section__title bd-section__title--light">color</h2>
          <p class="bd-section__sub bd-section__sub--light">
            Três paletas em harmonia com o sistema de cores do projeto.
          </p>
        </header>

        <div class="bd-grid bd-grid--3">
          <div class="bd-card bd-card--dark">
            <div class="bd-card__stage bd-card__stage--color">
              <Blob size="md" color="primary" animated position="center" />
            </div>
            <div class="bd-card__info">
              <code class="bd-code bd-code--light">color="primary"</code>
              <span class="bd-dim bd-dim--light">#7c3aed → #5b21b6</span>
            </div>
          </div>

          <div class="bd-card bd-card--dark">
            <div class="bd-card__stage bd-card__stage--color">
              <Blob size="md" color="secondary" animated position="center" delay={3} />
            </div>
            <div class="bd-card__info">
              <code class="bd-code bd-code--light">color="secondary"</code>
              <span class="bd-dim bd-dim--light">#6366f1 → #4338ca</span>
            </div>
          </div>

          <div class="bd-card bd-card--dark">
            <div class="bd-card__stage bd-card__stage--color">
              <Blob size="md" color="accent" animated position="center" delay={7} />
            </div>
            <div class="bd-card__info">
              <code class="bd-code bd-code--light">color="accent"</code>
              <span class="bd-dim bd-dim--light">#c4b5fd → #8b5cf6</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Animação ──────────────────────────────────── -->
    <section class="bd-section bd-section--light">
      <div class="container">
        <header class="bd-section__header">
          <span class="bd-label">prop</span>
          <h2 class="bd-section__title">animated</h2>
          <p class="bd-section__sub">
            Morphismo contínuo via <code class="bd-inline-code">border-radius</code> — suave,
            performático, respeitando <code class="bd-inline-code">prefers-reduced-motion</code>.
          </p>
        </header>

        <div class="bd-grid bd-grid--2">
          <div class="bd-card">
            <div class="bd-card__stage bd-card__stage--anim">
              <Blob size="md" color="primary" animated={true} position="center" />
            </div>
            <div class="bd-card__info">
              <code class="bd-code">animated={true}</code>
              <span class="bd-dim">morfismo a cada 14s</span>
            </div>
          </div>

          <div class="bd-card">
            <div class="bd-card__stage bd-card__stage--anim">
              <Blob size="md" color="primary" animated={false} position="center" />
            </div>
            <div class="bd-card__info">
              <code class="bd-code">animated={false}</code>
              <span class="bd-dim">forma estática</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Posição ───────────────────────────────────── -->
    <section class="bd-section bd-section--tinted">
      <div class="container">
        <header class="bd-section__header">
          <span class="bd-label">prop</span>
          <h2 class="bd-section__title">position</h2>
          <p class="bd-section__sub">
            Posicionamento absoluto dentro do elemento pai
            (<code class="bd-inline-code">position: relative</code>).
            Use <code class="bd-inline-code">overflow: hidden</code> para recortar.
          </p>
        </header>

        <div class="bd-pos-demo">
          <Blob size="sm" color="primary"   animated position="top-left"     />
          <Blob size="sm" color="secondary" animated position="top-right"    delay={3} />
          <Blob size="sm" color="accent"    animated position="bottom-left"  delay={6} />
          <Blob size="sm" color="primary"   animated position="bottom-right" delay={9} />
          <Blob size="sm" color="secondary" animated position="center"       delay={4} />

          <div class="bd-pos-demo__labels">
            <span class="bd-pos-label bd-pos-label--tl">top-left</span>
            <span class="bd-pos-label bd-pos-label--tr">top-right</span>
            <span class="bd-pos-label bd-pos-label--c">center</span>
            <span class="bd-pos-label bd-pos-label--bl">bottom-left</span>
            <span class="bd-pos-label bd-pos-label--br">bottom-right</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Uso real ──────────────────────────────────── -->
    <section class="bd-section bd-section--dark">
      <div class="container">
        <header class="bd-section__header bd-section__header--light">
          <span class="bd-label bd-label--dim">exemplo</span>
          <h2 class="bd-section__title bd-section__title--light">Uso em seções</h2>
          <p class="bd-section__sub bd-section__sub--light">
            Coloque blobs como decoração de fundo em qualquer seção com
            <code class="bd-inline-code bd-inline-code--dark">position: relative; overflow: hidden</code>.
          </p>
        </header>

        <!-- live preview -->
        <div class="bd-live">
          <Blob size="lg" color="primary"   animated position="top-right"    />
          <Blob size="md" color="secondary" animated position="bottom-left"  delay={6} />
          <Blob size="sm" color="accent"    animated position="top-left"     delay={3} />

          <div class="bd-live__content">
            <h3 class="bd-live__title">Organize seus sermões</h3>
            <p class="bd-live__text">
              Escreva, estruture e acesse seus esboços de qualquer lugar.
              Simples como deve ser.
            </p>
            <a class="bd-live__btn" href="#">Começar grátis</a>
          </div>
        </div>

        <!-- code -->
        <div class="bd-snippet">
          <div class="bd-snippet__bar">
            <span class="bd-snippet__dot"></span>
            <span class="bd-snippet__dot"></span>
            <span class="bd-snippet__dot"></span>
            <span class="bd-snippet__file">MinhaSecao.astro</span>
          </div>
          <pre class="bd-snippet__pre"><code>{`---
import Blob from '../components/ui/Blob.astro';
---

<section class="hero" style="position: relative; overflow: hidden;">
  <Blob size="lg" color="primary"   animated position="top-right" />
  <Blob size="md" color="secondary" animated position="bottom-left" delay={5} />

  <div class="container">
    <!-- conteúdo da seção -->
  </div>
</section>`}</code></pre>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* ── Hero ──────────────────────────────────────── */
  .bd-hero {
    position: relative;
    overflow: hidden;
    padding: 8rem 0 6rem;
    background: linear-gradient(135deg, #0f0a1e 0%, #1e1245 55%, #2e1065 100%);
  }

  .bd-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .bd-tag {
    display: inline-block;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #a78bfa;
    background: rgba(167, 139, 250, .12);
    border: 1px solid rgba(167, 139, 250, .25);
    border-radius: 9999px;
    padding: .3rem .9rem;
  }

  .bd-hero__title {
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 800;
    letter-spacing: -.04em;
    line-height: 1;
    background: linear-gradient(135deg, #e9d5ff 0%, #c4b5fd 40%, #a78bfa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .bd-hero__sub {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, .6);
    max-width: 480px;
    line-height: 1.75;
  }

  .bd-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    justify-content: center;
    margin-top: .5rem;
  }

  .bd-pill {
    font-size: .8125rem;
    font-weight: 500;
    font-family: 'Courier New', monospace;
    color: rgba(255, 255, 255, .5);
    background: rgba(255, 255, 255, .06);
    border: 1px solid rgba(255, 255, 255, .1);
    border-radius: 6px;
    padding: .25rem .7rem;
  }

  /* ── Section chrome ────────────────────────────── */
  .bd-section { padding: 5.5rem 0; }
  .bd-section--light  { background: #fff; }
  .bd-section--tinted { background: linear-gradient(180deg, #faf8ff 0%, #f5f3ff 100%); }
  .bd-section--dark   {
    background: linear-gradient(135deg, #0f0a1e 0%, #1e1245 55%, #2e1065 100%);
  }

  .bd-section__header {
    text-align: center;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .6rem;
  }
  .bd-section__header--light { /* inside dark section, handled by modifier classes */ }

  .bd-label {
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    border: 1px solid rgba(124, 58, 237, .2);
    border-radius: 9999px;
    padding: .2rem .75rem;
  }
  .bd-label--dim {
    color: #a78bfa;
    background: rgba(167, 139, 250, .12);
    border-color: rgba(167, 139, 250, .25);
  }

  .bd-section__title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--color-text);
    font-family: 'Courier New', monospace;
  }
  .bd-section__title--light { color: #f5f3ff; }

  .bd-section__sub {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 520px;
    line-height: 1.7;
  }
  .bd-section__sub--light { color: rgba(255, 255, 255, .55); }

  .bd-inline-code {
    font-family: 'Courier New', monospace;
    font-size: .875em;
    background: var(--color-bg-muted);
    border-radius: 4px;
    padding: .1em .35em;
    color: var(--color-primary-dark);
  }
  .bd-inline-code--dark {
    background: rgba(255, 255, 255, .1);
    color: #c4b5fd;
  }

  /* ── Grid ──────────────────────────────────────── */
  .bd-grid { display: grid; gap: 1.25rem; }
  .bd-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .bd-grid--2 { grid-template-columns: repeat(2, 1fr); }

  /* ── Cards ─────────────────────────────────────── */
  .bd-card {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: #fff;
    overflow: hidden;
    transition: box-shadow .22s ease, transform .22s ease;
  }
  .bd-card:hover {
    box-shadow: 0 12px 32px rgba(124, 58, 237, .1);
    transform: translateY(-2px);
  }
  .bd-card--dark {
    background: rgba(255, 255, 255, .04);
    border-color: rgba(255, 255, 255, .08);
  }
  .bd-card--dark:hover {
    box-shadow: 0 12px 40px rgba(124, 58, 237, .25);
    transform: translateY(-2px);
  }

  .bd-card__stage {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #faf8ff 0%, #f5f3ff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bd-card__stage--sm    { height: 180px; }
  .bd-card__stage--md    { height: 220px; }
  .bd-card__stage--lg    { height: 260px; }
  .bd-card__stage--color { height: 220px; background: rgba(255, 255, 255, .03); }
  .bd-card__stage--anim  { height: 240px; }

  .bd-card__info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .875rem 1.1rem;
    border-top: 1px solid var(--color-border);
    gap: .75rem;
  }
  .bd-card--dark .bd-card__info {
    border-top-color: rgba(255, 255, 255, .08);
  }

  .bd-code {
    font-family: 'Courier New', monospace;
    font-size: .8125rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    border-radius: 5px;
    padding: .2rem .55rem;
  }
  .bd-code--light {
    color: #c4b5fd;
    background: rgba(167, 139, 250, .15);
  }

  .bd-dim {
    font-size: .8125rem;
    color: var(--color-text-subtle);
    font-family: 'Courier New', monospace;
  }
  .bd-dim--light { color: rgba(255, 255, 255, .3); }

  /* ── Position demo ─────────────────────────────── */
  .bd-pos-demo {
    position: relative;
    overflow: hidden;
    height: 420px;
    max-width: 680px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #fdfcff 0%, #f5f3ff 100%);
    border: 1px solid rgba(124, 58, 237, .12);
    box-shadow: 0 4px 32px rgba(124, 58, 237, .08);
  }

  .bd-pos-demo__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .bd-pos-label {
    position: absolute;
    font-family: 'Courier New', monospace;
    font-size: .75rem;
    font-weight: 600;
    color: var(--color-primary);
    background: rgba(255, 255, 255, .85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(124, 58, 237, .2);
    border-radius: 6px;
    padding: .2rem .5rem;
  }
  .bd-pos-label--tl { top: 1rem;   left:  1rem; }
  .bd-pos-label--tr { top: 1rem;   right: 1rem; }
  .bd-pos-label--c  {
    top: 50%;
    left: 50%;
    transform: translate(-50%, calc(-50% + 60px));
  }
  .bd-pos-label--bl { bottom: 1rem; left:  1rem; }
  .bd-pos-label--br { bottom: 1rem; right: 1rem; }

  /* ── Live demo ─────────────────────────────────── */
  .bd-live {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 100%);
    padding: 4.5rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 2rem;
    min-height: 320px;
    justify-content: center;
  }

  .bd-live__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .bd-live__title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -.03em;
    color: #fff;
    line-height: 1.15;
  }

  .bd-live__text {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, .65);
    max-width: 400px;
    line-height: 1.7;
  }

  .bd-live__btn {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    font-size: .9375rem;
    background: rgba(255, 255, 255, .12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 9999px;
    padding: .7rem 1.75rem;
    transition: background .2s ease, transform .2s ease;
  }
  .bd-live__btn:hover {
    background: rgba(255, 255, 255, .2);
    transform: translateY(-1px);
  }

  /* ── Code snippet ──────────────────────────────── */
  .bd-snippet {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .08);
    background: #0d0920;
  }

  .bd-snippet__bar {
    display: flex;
    align-items: center;
    gap: .4rem;
    padding: .75rem 1.25rem;
    background: rgba(255, 255, 255, .04);
    border-bottom: 1px solid rgba(255, 255, 255, .07);
  }

  .bd-snippet__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .12);
  }
  .bd-snippet__dot:nth-child(1) { background: #ff5f57; }
  .bd-snippet__dot:nth-child(2) { background: #febc2e; }
  .bd-snippet__dot:nth-child(3) { background: #28c840; }

  .bd-snippet__file {
    margin-left: .5rem;
    font-family: 'Courier New', monospace;
    font-size: .8125rem;
    color: rgba(255, 255, 255, .35);
  }

  .bd-snippet__pre {
    margin: 0;
    padding: 1.5rem 1.75rem;
    overflow-x: auto;
    font-family: 'Courier New', monospace;
    font-size: .875rem;
    line-height: 1.7;
    color: #c4b5fd;
  }

  .bd-snippet__pre code { color: inherit; }

  /* ── Responsive ────────────────────────────────── */
  @media (max-width: 800px) {
    .bd-grid--3 { grid-template-columns: 1fr; }
    .bd-grid--2 { grid-template-columns: 1fr; }
    .bd-live    { padding: 3rem 1.5rem; }
    .bd-pos-demo { height: 300px; }
  }

  @media (max-width: 500px) {
    .bd-hero { padding: 6rem 0 4rem; }
    .bd-hero__title { font-size: 4rem; }
  }
</style>

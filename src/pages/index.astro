---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import AppPreview from '../components/sections/AppPreview.astro';
import Differentials from '../components/sections/Differentials.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTA from '../components/sections/CTA.astro';
import Footer from '../components/sections/Footer.astro';
import { faqs } from '../data/faq';
---

<Layout>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Esboço Online',
    url: 'https://esbocoonline.com.br',
  })} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Esboço Online',
    url: 'https://esbocoonline.com.br',
    logo: 'https://esbocoonline.com.br/favicon.svg',
    description: 'A plataforma completa para pastores e pregadores gerenciarem esboços, estudar a Bíblia e organizar a agenda ministerial.',
    sameAs: ['https://app.esbocoonline.com.br'],
  })} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Esboço Online',
    operatingSystem: 'Web',
    applicationCategory: 'ProductivityApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
    description: 'A plataforma completa para pastores e pregadores gerenciarem esboços, estudar a Bíblia e organizar a agenda ministerial.',
    url: 'https://app.esbocoonline.com.br',
  })} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  })} />
  <Navbar />
  <main>
    <Hero />
    <Features />
    <AppPreview />
    <Differentials />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Layout>

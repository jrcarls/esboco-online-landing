---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Differentials from '../components/sections/Differentials.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTA from '../components/sections/CTA.astro';
import Footer from '../components/sections/Footer.astro';
---

<Layout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Esboço Online',
    url: 'https://esbocoonline.com.br',
    logo: 'https://esbocoonline.com.br/favicon.svg',
    description: 'A plataforma completa para pastores e pregadores gerenciarem esboços, estudar a Bíblia e organizar a agenda ministerial.',
    sameAs: ['https://app.esbocoonline.com.br'],
  })} />
  <Navbar />
  <main>
    <Hero />
    <Features />
    <Differentials />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Layout>
